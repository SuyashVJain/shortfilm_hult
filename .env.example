# Neon: pooled connection (runtime, via the Neon adapter)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Neon: direct connection (migrations, Prisma Studio)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Better Auth. Generate a secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Gmail SMTP (OTP email, lib/mailer.ts)
# SMTP_USER: the Gmail address. SMTP_PASS: a Google app password, NOT the account password.
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Short Film Competition <address@gmail.com>"

# First admin, created by npm run db:seed (signs in with email OTP)
ADMIN_EMAIL=""

# Vercel Blob (payment screenshots only)
BLOB_READ_WRITE_TOKEN=""
